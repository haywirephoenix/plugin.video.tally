{
    "id": "floppy",
    "name": "Floppy",
    "description": "A Floppy CSV export: watchlist, watched movies and episodes, resume points.",
    "format": "csv",
    "extensions": [".csv"],
    "detect": ["row_type", "media_id", "source", "media_type", "played_up_to_seconds"],
    "fields": {
        "kind": {
            "column": "media_type",
            "map": {"movie": "movie", "tv": "tv", "anime": "tv", "season": "season", "episode": "episode"}
        },
        "tmdb": [
            {"column": "media_id", "when": {"source": "tmdb"}},
            {"column": "provider_external_ids", "convert": "json", "key": "tmdb_id"}
        ],
        "imdb": {"column": "provider_external_ids", "convert": "json", "key": "imdb_id"},
        "tvdb": {"column": "provider_external_ids", "convert": "json", "key": "tvdb_id"},
        "title": ["title", "localized_title", "series_name"],
        "year": {"column": "release_datetime", "convert": "year"},
        "poster": "image",
        "season": {"column": "season_number", "convert": "int"},
        "episode": {"column": "episode_number", "convert": "int"},
        "status": [
            {
                "column": "status#2",
                "map": {
                    "0": "planning", "planning": "planning", "plan to watch": "planning",
                    "1": "in_progress", "in progress": "in_progress", "in_progress": "in_progress",
                    "watching": "in_progress",
                    "2": "paused", "paused": "paused", "on hold": "paused",
                    "3": "completed", "completed": "completed", "watched": "completed",
                    "4": "dropped", "dropped": "dropped"
                }
            },
            {"column": "list_name", "map": {"watchlist": "planning"}}
        ],
        "position": {"column": "played_up_to_seconds", "convert": "float"},
        "duration": [
            {"column": "length_seconds", "convert": "float"},
            {"column": "runtime_minutes", "convert": "minutes"}
        ],
        "watched_at": {
            "columns": ["end_date", "progressed_at", "position_updated_at", "created_at"],
            "convert": "time"
        },
        "added_at": {"columns": ["created_at", "start_date", "list_item_date_added"], "convert": "time"},
        "updated_at": {"columns": ["position_updated_at", "progressed_at", "created_at"], "convert": "time"}
    },
    "statuses": {"paused": "in_progress", "dropped": null}
}
